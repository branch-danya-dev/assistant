{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expression",
    "scale",
    "rounding",
    "unit"
  ],
  "properties": {
    "expression": {
      "$ref": "#/$defs/node"
    },
    "scale": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "rounding": {
      "const": "half_even"
    },
    "unit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "scalar"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "count"
            },
            "name": {
              "const": "item"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "code"
          ],
          "properties": {
            "kind": {
              "const": "currency"
            },
            "code": {
              "enum": [
                "RUB",
                "USD",
                "EUR",
                "JPY",
                "KWD"
              ]
            }
          }
        }
      ]
    }
  },
  "$id": "urn:personal-agent:calculate-input-v1",
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value",
            "unit"
          ],
          "properties": {
            "op": {
              "const": "literal"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,6})?$",
              "maxLength": 26
            },
            "unit": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "scalar"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name"
                  ],
                  "properties": {
                    "kind": {
                      "const": "count"
                    },
                    "name": {
                      "const": "item"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "code"
                  ],
                  "properties": {
                    "kind": {
                      "const": "currency"
                    },
                    "code": {
                      "enum": [
                        "RUB",
                        "USD",
                        "EUR",
                        "JPY",
                        "KWD"
                      ]
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "negate"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "add",
                "subtract",
                "multiply",
                "divide",
                "percent"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
