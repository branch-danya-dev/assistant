{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/personal-agent/memory-record.schema.json",
  "title": "MemoryRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "project_id",
    "kind",
    "statement",
    "source_refs",
    "evidence_status",
    "recorded_at",
    "supersedes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "fact",
        "decision",
        "preference",
        "procedure",
        "event"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_status": {
      "enum": [
        "reported",
        "observed",
        "inferred",
        "verified"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "private",
        "restricted"
      ]
    },
    "retention_class": {
      "type": "string",
      "enum": [
        "durable",
        "project",
        "temporary",
        "archive",
        "user_managed"
      ]
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
