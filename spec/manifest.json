      "context_cost": "medium"
    },
    {
      "path": "spec/scenarios.json",
      "role": "EVALUATION",
      "purpose": "End-to-end acceptance scenarios",
      "context_cost": "small"
    },
    {
      "path": "spec/milestones.json",
      "role": "ROADMAP",
      "purpose": "Exit gates by milestone",
      "context_cost": "small"
    },
    {
      "path": "spec/components.json",
      "role": "COMPONENTS",
