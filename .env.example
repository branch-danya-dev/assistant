# Reference only: the CLI does not load .env automatically.
# Export this one root in PowerShell or set it in Windows User environment.
# All subdirectories derive from spec/storage-config.json. No fallback to C:.
ASSISTANT_ROOT=G:\Assistant
# Model/provider/context come from spec/model-config.json; other env flags are not read.
# Ollama Desktop needs separately configured Windows User OLLAMA_MODELS derived from
# ASSISTANT_ROOT + models/ollama, followed by restart. This file cannot configure it.
# Secrets belong in an approved OS-backed vault, not here.
