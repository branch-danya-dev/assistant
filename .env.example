# Only one absolute application root is configured. All subdirectories derive from spec/storage-config.json.
# Set ASSISTANT_ROOT explicitly on a different disk/host. Never silently fall back to C:.
ASSISTANT_ROOT=G:\Assistant
ASSISTANT_LOG_LEVEL=INFO
ASSISTANT_NETWORK_MODE=local
ASSISTANT_LLM_PROVIDER=ollama
ASSISTANT_LLM_MODEL=qwen3.5:9b
ASSISTANT_LLM_BASE_URL=http://127.0.0.1:11434
ASSISTANT_LLM_CONTEXT_TOKENS=8192
# Ollama Desktop does NOT load this app .env. Configure Windows User OLLAMA_MODELS
# from effective ASSISTANT_ROOT + models/ollama before pulling model, then restart Ollama.
# Secrets belong in an approved OS-backed vault, not here.
