# Template for FUTURE runtime. The agent and Ollama adapter are not implemented yet.
# Do not commit credentials, personal data or production memory.
ASSISTANT_DATA_DIR=.local/data
ASSISTANT_LOG_LEVEL=INFO
ASSISTANT_NETWORK_MODE=local
ASSISTANT_LLM_PROVIDER=ollama
ASSISTANT_LLM_MODEL=qwen3.5:9b
ASSISTANT_LLM_BASE_URL=http://127.0.0.1:11434
ASSISTANT_LLM_CONTEXT_TOKENS=8192
# Cloud provider is disabled unless the owner enables explicit consent-gated routing.
# CLOUD_API_KEY=
