# Future runtime template: not installed on the host.
# Windows Ollama Desktop requires OLLAMA_MODELS in the User environment as well.
ASSISTANT_ROOT=G:\Assistant
ASSISTANT_DATA_DIR=G:\Assistant\data
ASSISTANT_DB_DIR=G:\Assistant\data\db
ASSISTANT_HISTORY_DIR=G:\Assistant\data\history
ASSISTANT_MEMORY_DIR=G:\Assistant\data\memory
ASSISTANT_IDENTITY_DIR=G:\Assistant\data\identity
ASSISTANT_SKILLS_DIR=G:\Assistant\data\skills
ASSISTANT_WORKSPACE_DIR=G:\Assistant\workspace
ASSISTANT_LOG_DIR=G:\Assistant\logs
ASSISTANT_CACHE_DIR=G:\Assistant\cache
ASSISTANT_BACKUP_DIR=G:\Assistant\backups
OLLAMA_MODELS=G:\Assistant\models\ollama
ASSISTANT_LOG_LEVEL=INFO
ASSISTANT_NETWORK_MODE=local
ASSISTANT_LLM_PROVIDER=ollama
ASSISTANT_LLM_MODEL=qwen3.5:9b
ASSISTANT_LLM_BASE_URL=http://127.0.0.1:11434
ASSISTANT_LLM_CONTEXT_TOKENS=8192
# CLOUD_API_KEY=  # only after explicit opt-in
